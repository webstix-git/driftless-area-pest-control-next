# Public key from your Cloudflare Turnstile widget configuration.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Keep this private. Use it in your server-side contact submission endpoint to
# verify cf-turnstile-response through Cloudflare's Siteverify API.
TURNSTILE_SECRET_KEY=

# Google Analytics 4 measurement ID (e.g. G-7DJ73CJME0).
# Must also be set in the hosting provider env (Vercel/Netlify/etc) for production.
# Loaded once in the root layout on every page when set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Canonical site origin (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.driftlessareapestcontrol.com
