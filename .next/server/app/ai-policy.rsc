7:["$","p","AI may also help summarize notes, organize checklists, or support administrative drafting. Final published content and customer recommendations are reviewed by our team.",{"children":"AI may also help summarize notes, organize checklists, or support administrative drafting. Final published content and customer recommendations are reviewed by our team."}]
8:["$","section","What AI is not used for",{"className":"legal-section","children":[["$","h3",null,{"children":"What AI is not used for"}],[["$","p","We do not rely on AI alone to diagnose pest conditions at your facility, prescribe treatments, or make binding service commitments.",{"children":"We do not rely on AI alone to diagnose pest conditions at your facility, prescribe treatments, or make binding service commitments."}],["$","p","On-site inspection, monitoring, and treatment decisions remain human-led and based on facility conditions, safety requirements, and practical experience.",{"children":"On-site inspection, monitoring, and treatment decisions remain human-led and based on facility conditions, safety requirements, and practical experience."}]],null]}]
9:["$","section","Accuracy and review",{"className":"legal-section","children":[["$","h3",null,{"children":"Accuracy and review"}],[["$","p","Website content is prepared to be practical and useful for farms and commercial facilities. Because AI-assisted drafts can contain mistakes, our team reviews content before publication whenever practical.",{"children":"Website content is prepared to be practical and useful for farms and commercial facilities. Because AI-assisted drafts can contain mistakes, our team reviews content before publication whenever practical."}],["$","p","If you notice an error or outdated detail, contact us and we will review it.",{"children":"If you notice an error or outdated detail, contact us and we will review it."}]],null]}]
a:["$","section","Customer information",{"className":"legal-section","children":[["$","h3",null,{"children":"Customer information"}],[["$","p","We take care not to place sensitive customer, employee, or proprietary facility information into public AI tools. Service requests submitted through our site are handled by our team for follow-up.",{"children":"We take care not to place sensitive customer, employee, or proprietary facility information into public AI tools. Service requests submitted through our site are handled by our team for follow-up."}],["$","p","For more detail on how we handle personal information, see our Privacy Policy.",{"children":"For more detail on how we handle personal information, see our Privacy Policy."}]],["$","p",null,{"children":["Review our"," ",["$","a",null,{"href":"/privacy-policy","children":"Privacy Policy"}]," for how contact details and form submissions are handled."]}]]}]
b:["$","section","Transparency",{"className":"legal-section","children":[["$","h3",null,{"children":"Transparency"}],[["$","p","This page exists so visitors understand that some website materials may be developed with AI assistance under human review. Our goal is clear, useful information for facility managers — not automated decision-making.",{"children":"This page exists so visitors understand that some website materials may be developed with AI assistance under human review. Our goal is clear, useful information for facility managers — not automated decision-making."}]],null]}]
c:["$","section","Questions",{"className":"legal-section","children":[["$","h3",null,{"children":"Questions"}],[["$","p","If you have questions about this AI Policy, call or email Driftless Area Pest Control using the contact details below.",{"children":"If you have questions about this AI Policy, call or email Driftless Area Pest Control using the contact details below."}]],null]}]
