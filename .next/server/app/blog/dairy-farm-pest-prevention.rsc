5:["$","$L4",null,{"children":["$","div",null,{"className":"blog-detail-page","children":[["$","$L10",null,{"title":"Pest Prevention Strategies for Modern Dairy Farms","imageSrc":"/images/blog_dairy.jpg","imageAlt":"Holstein dairy cows feeding in a modern barn","objectPosition":"center 30%"}],["$","$L11",null,{"items":[{"label":"Home","href":"/"},{"label":"Blog","href":"/blog"},{"label":"Pest Prevention Strategies for Modern Dairy Farms"}]}],["$","article",null,{"className":"blog-post page-section bg-cream","children":["$","div",null,{"className":"container blog-post-layout","children":[["$","div",null,{"className":"blog-post-main reveal-up","children":["$","div",null,{"className":"blog-post-panel","children":[["$","div",null,{"className":"blog-post-meta","children":[["$","span",null,{"className":"blog-card-tag","children":"Agricultural Pest Management"}],["$","a",null,{"href":"/agricultural-pest-control","className":"blog-post-service-link","children":["Related: ","Agricultural Pest Control",["$","svg",null,{"className":"icon","viewBox":"0 0 24 24","aria-hidden":"true","children":[["$","line",null,{"x1":"5","x2":"19","y1":"12","y2":"12"}],["$","polyline",null,{"points":"12 5 19 12 12 19"}]]}]]}]]}],["$","div",null,{"className":"blog-post-featured","children":["$","img",null,{"src":"/images/blog_dairy.jpg","alt":"Holstein dairy cows feeding in a modern barn"}]}],["$","div",null,{"className":"blog-post-body","children":[[["$","p","intro-0",{"className":"blog-post-lead","children":"Dairy farms deal with pest pressure in places that matter for herd health and milk quality — barns, parlors, calf areas, feed alleys, and manure handling zones. Flies and rodents thrive where moisture, feed, and shelter overlap."}],["$","p","intro-1",{"className":"$undefined","children":"Strong prevention is less about a single treatment and more about how the farm runs day to day: sanitation timing, structural openings, and biosecurity habits that keep pressure from building between visits."}]],[["$","section","Focus on the high-pressure zones first",{"className":"blog-post-section","children":[["$","h2",null,{"children":"Focus on the high-pressure zones first"}],[["$","p","Focus on the high-pressure zones first-p-0",{"children":"Not every part of a dairy has equal risk. Start where pests gain the most advantage — feed storage, parlor perimeters, calf housing, and areas where manure or spilled feed sits longer than it should."}]],["$","ul",null,{"className":"page-checklist blog-post-checklist","children":[["$","li","Walk barns and parlors with an eye for moisture and spilled feed",{"children":"Walk barns and parlors with an eye for moisture and spilled feed"}],["$","li","Check calf areas and hospital pens for harborage and attractants",{"children":"Check calf areas and hospital pens for harborage and attractants"}],["$","li","Inspect feed alleys, bunkers, and storage for rodent travel paths",{"children":"Inspect feed alleys, bunkers, and storage for rodent travel paths"}]]}]]}],["$","section","Reduce fly pressure around barns and parlors",{"className":"blog-post-section","children":[["$","h2",null,{"children":"Reduce fly pressure around barns and parlors"}],[["$","p","Reduce fly pressure around barns and parlors-p-0",{"children":"Fly pressure rises with warmth, moisture, and organic debris. Prevention works best when sanitation and structural habits support it — cleaned edges, managed manure flow, and fewer wet corners near animal housing."}],["$","p","Reduce fly pressure around barns and parlors-p-1",{"children":"Targeted treatment still has a place, but lasting results usually come from correcting the conditions that keep flies reproducing on site."}]],null]}],["$","section","Keep rodents out of feed and structural gaps",{"className":"blog-post-section","children":[["$","h2",null,{"children":"Keep rodents out of feed and structural gaps"}],[["$","p","Keep rodents out of feed and structural gaps-p-0",{"children":"Rodents follow feed and shelter. Door gaps, utility penetrations, cluttered storage, and soft building materials give them easy access. A dairy rodent plan should combine inspection, exclusion where practical, and monitoring that fits farm traffic patterns."}]],null]}],"$L12"]]}]]}]}],"$L13"]}]}],"$L14","$L15"]}]}]
