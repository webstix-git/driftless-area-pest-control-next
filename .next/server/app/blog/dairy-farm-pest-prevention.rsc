12:["$","section","Build prevention into biosecurity routines",{"className":"blog-post-section","children":[["$","h2",null,{"children":"Build prevention into biosecurity routines"}],[["$","p","Build prevention into biosecurity routines-p-0",{"children":"Pest work on dairies has to respect livestock protocols and production schedules. The most useful programs follow site rules, communicate clearly with managers, and document what was found so the next visit builds on the last."}]],["$","ul",null,{"className":"page-checklist blog-post-checklist","children":[["$","li","Align service timing with milking and chore schedules when possible",{"children":"Align service timing with milking and chore schedules when possible"}],["$","li","Follow farm biosecurity expectations for entry and movement",{"children":"Follow farm biosecurity expectations for entry and movement"}],["$","li","Keep notes managers can use for herd health and facility conversations",{"children":"Keep notes managers can use for herd health and facility conversations"}]]}]]}]
