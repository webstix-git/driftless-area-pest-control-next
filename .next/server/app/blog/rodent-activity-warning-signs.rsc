13:["$","p","4. Nesting material and shredded debris-p-0",{"children":"Nests can form in wall voids, cluttered storage, insulation, and unused equipment. Shredded paper, packaging film, or soft debris pulled into a quiet corner often means rodents have settled in, not just passed through."}]
14:["$","section","5. Live or dead rodents, and unusual pet or staff reports",{"className":"blog-post-section","children":[["$","h2",null,{"children":"5. Live or dead rodents, and unusual pet or staff reports"}],[["$","p","5. Live or dead rodents, and unusual pet or staff reports-p-0",{"children":"A daytime sighting usually means pressure is already high. Staff reports of scratching in walls, odd smells, or rodents near docks and trash areas should trigger a walkthrough the same day — not a wait-and-see approach."}]],null]}]
15:["$","section","What to do next",{"className":"blog-post-section","children":[["$","h2",null,{"children":"What to do next"}],[["$","p","What to do next-p-0",{"children":"When you see one or more of these signs, treat the situation as a facility issue — not a one-time clean-up. A practical response starts with inspection, then moves into source correction and ongoing monitoring."}]],["$","ul",null,{"className":"page-checklist blog-post-checklist","children":[["$","li","Walk the site and map droppings, gnaw points, and likely entry gaps",{"children":"Walk the site and map droppings, gnaw points, and likely entry gaps"}],["$","li","Reduce food, water, and clutter that keep rodents in place",{"children":"Reduce food, water, and clutter that keep rodents in place"}],["$","li","Seal openings around docks, pipes, and foundation gaps where possible",{"children":"Seal openings around docks, pipes, and foundation gaps where possible"}],["$","li","Set a monitoring plan so activity stays visible between visits",{"children":"Set a monitoring plan so activity stays visible between visits"}]]}]]}]
16:["$","aside",null,{"className":"blog-post-aside reveal-up stagger-delay-1","children":[["$","div",null,{"className":"blog-post-takeaways","children":[["$","span",null,{"className":"section-eyebrow","children":"Quick Read"}],["$","h3",null,{"children":"Key Takeaways"}],["$","ul",null,{"className":"page-checklist blog-post-checklist","children":[["$","li","Early signs matter more than waiting for a live sighting",{"children":"Early signs matter more than waiting for a live sighting"}],["$","li","Track where activity clusters — walls, docks, storage, and warm rooms",{"children":"Track where activity clusters — walls, docks, storage, and warm rooms"}],["$","li","Fix entry points and attractants, not just the surface evidence",{"children":"Fix entry points and attractants, not just the surface evidence"}],["$","li","Keep monitoring in place so pressure stays visible between service visits",{"children":"Keep monitoring in place so pressure stays visible between service visits"}]]}]]}],["$","div",null,{"className":"blog-post-help","children":[["$","span",null,{"className":"section-eyebrow","children":"On-Site Support"}],["$","h3",null,{"children":"Need help on site?"}],["$","p",null,{"children":"If this issue is showing up in your facility, we can walk the site and outline a practical next step."}],["$","a",null,{"href":"/rodent-control","className":"blog-post-aside-link","children":["View ","Rodent Control & Exclusion",["$","svg",null,{"className":"icon","viewBox":"0 0 24 24","aria-hidden":"true","children":[["$","line",null,{"x1":"5","x2":"19","y1":"12","y2":"12"}],["$","polyline",null,{"points":"12 5 19 12 12 19"}]]}]]}]]}]]}]
