5:["$","$L4",null,{"children":["$","div",null,{"className":"blog-detail-page","children":[["$","$L10",null,{"title":"5 Signs of Rodent Activity in Your Facility (And What to Do)","imageSrc":"/images/blog_rodent.jpg","imageAlt":"Rodent peeking from a hole in a concrete facility wall","objectPosition":"center 40%"}],["$","$L11",null,{"items":[{"label":"Home","href":"/"},{"label":"Blog","href":"/blog"},{"label":"5 Signs of Rodent Activity in Your Facility (And What to Do)"}]}],["$","article",null,{"className":"blog-post page-section bg-cream","children":["$","div",null,{"className":"container blog-post-layout","children":[["$","div",null,{"className":"blog-post-main reveal-up","children":["$","div",null,{"className":"blog-post-panel","children":[["$","div",null,{"className":"blog-post-meta","children":[["$","span",null,{"className":"blog-card-tag","children":"Rodent Control"}],["$","a",null,{"href":"/rodent-control","className":"blog-post-service-link","children":["Related: ","Rodent Control & Exclusion",["$","svg",null,{"className":"icon","viewBox":"0 0 24 24","aria-hidden":"true","children":[["$","line",null,{"x1":"5","x2":"19","y1":"12","y2":"12"}],["$","polyline",null,{"points":"12 5 19 12 12 19"}]]}]]}]]}],["$","div",null,{"className":"blog-post-featured","children":["$","img",null,{"src":"/images/blog_rodent.jpg","alt":"Rodent peeking from a hole in a concrete facility wall"}]}],["$","div",null,{"className":"blog-post-body","children":[[["$","p","intro-0",{"className":"blog-post-lead","children":"Rodent pressure rarely starts with a dramatic sighting. In warehouses, food plants, and commercial buildings, early signs usually show up in quiet corners — along walls, behind racking, near docks, and around stored product."}],["$","p","intro-1",{"className":"$undefined","children":"Catching those signs early gives your team time to inspect, seal openings, and correct attractants before activity spreads through the facility."}]],[["$","section","1. Droppings and urine trails",{"className":"blog-post-section","children":[["$","h2",null,{"children":"1. Droppings and urine trails"}],[["$","p","1. Droppings and urine trails-p-0",{"children":"Fresh droppings along baseboards, pallet edges, and storage aisles are one of the clearest early warnings. Look near food storage, packaging, and warm mechanical rooms where rodents travel after dark."}]],["$","ul",null,{"className":"page-checklist blog-post-checklist","children":[["$","li","Check along walls and under racking during night or early-morning walks",{"children":"Check along walls and under racking during night or early-morning walks"}],["$","li","Note concentration near docks, trash rooms, and break areas",{"children":"Note concentration near docks, trash rooms, and break areas"}],["$","li","Mark locations so your team can track whether pressure is spreading",{"children":"Mark locations so your team can track whether pressure is spreading"}]]}]]}],["$","section","2. Gnaw marks on packaging and structure",{"className":"blog-post-section","children":[["$","h2",null,{"children":"2. Gnaw marks on packaging and structure"}],[["$","p","2. Gnaw marks on packaging and structure-p-0",{"children":"Mice and rats chew to keep their teeth worn down and to open paths through packaging, foam, wood, and soft building materials. Fresh gnaw marks on bags, boxes, insulation, or door sweeps are a strong signal that rodents are active and feeding nearby."}]],null]}],["$","section","3. Rub marks and grease trails",{"className":"blog-post-section","children":[["$","h2",null,{"children":"3. Rub marks and grease trails"}],[["$","p","3. Rub marks and grease trails-p-0",{"children":"Rodents often use the same travel paths. Over time, dirty fur leaves dark rub marks along walls, pipes, and openings. These trails help you map how animals are moving through the building — and where exclusion work should focus."}]],null]}],["$","section","4. Nesting material and shredded debris",{"className":"blog-post-section","children":["$L12",["$L13"],null]}],"$L14","$L15"]]}]]}]}],"$L16"]}]}],"$L17","$L18"]}]}]
