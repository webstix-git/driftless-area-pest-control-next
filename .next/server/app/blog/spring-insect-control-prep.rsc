12:["$","section","Set a monitoring plan for the season",{"className":"blog-post-section","children":[["$","h2",null,{"children":"Set a monitoring plan for the season"}],[["$","p","Set a monitoring plan for the season-p-0",{"children":"Spring is a good time to reset sticky monitors, document baseline activity, and walk high-risk zones on a regular cadence. When activity rises, your team already knows where to look and what changed."}]],["$","ul",null,{"className":"page-checklist blog-post-checklist","children":[["$","li","Place monitors in kitchens, docks, and mechanical rooms",{"children":"Place monitors in kitchens, docks, and mechanical rooms"}],["$","li","Record findings so trends are visible week to week",{"children":"Record findings so trends are visible week to week"}],["$","li","Schedule a facility walkthrough before peak warm weather",{"children":"Schedule a facility walkthrough before peak warm weather"}]]}]]}]
