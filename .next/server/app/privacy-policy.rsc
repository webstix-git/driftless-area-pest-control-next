7:["$","p","We may also collect basic technical information such as browser type, device type, and pages visited to help us improve site performance and understand how the site is used.",{"children":"We may also collect basic technical information such as browser type, device type, and pages visited to help us improve site performance and understand how the site is used."}]
8:["$","section","How we use information",{"className":"legal-section","children":[["$","h3",null,{"children":"How we use information"}],[["$","p","We use submitted information to respond to service requests, schedule inspections, answer questions, and communicate about programs that may fit your facility.",{"children":"We use submitted information to respond to service requests, schedule inspections, answer questions, and communicate about programs that may fit your facility."}],["$","p","We do not sell personal information. We do not use your information for unrelated marketing lists.",{"children":"We do not sell personal information. We do not use your information for unrelated marketing lists."}]]]}]
9:["$","section","Sharing of information",{"className":"legal-section","children":[["$","h3",null,{"children":"Sharing of information"}],[["$","p","We may share information with trusted service providers who help us operate the website or communicate with customers (for example, hosting or email delivery), only as needed to provide those services.",{"children":"We may share information with trusted service providers who help us operate the website or communicate with customers (for example, hosting or email delivery), only as needed to provide those services."}],["$","p","We may also disclose information if required by law or to protect the safety, rights, or property of our company, customers, or the public.",{"children":"We may also disclose information if required by law or to protect the safety, rights, or property of our company, customers, or the public."}]]]}]
a:["$","section","Cookies and analytics",{"className":"legal-section","children":[["$","h3",null,{"children":"Cookies and analytics"}],[["$","p","Our site may use cookies or similar tools that support basic site function and performance. You can control cookies through your browser settings. Disabling cookies may affect how some parts of the site work.",{"children":"Our site may use cookies or similar tools that support basic site function and performance. You can control cookies through your browser settings. Disabling cookies may affect how some parts of the site work."}]]]}]
b:["$","section","Data retention",{"className":"legal-section","children":[["$","h3",null,{"children":"Data retention"}],[["$","p","We keep contact and service-request information only as long as needed to respond to your inquiry, provide service, meet business records needs, or comply with legal requirements.",{"children":"We keep contact and service-request information only as long as needed to respond to your inquiry, provide service, meet business records needs, or comply with legal requirements."}]]]}]
c:["$","section","Your choices",{"className":"legal-section","children":[["$","h3",null,{"children":"Your choices"}],[["$","p","You may request updates to your contact details or ask questions about information you have submitted by calling or emailing us using the contact details below.",{"children":"You may request updates to your contact details or ask questions about information you have submitted by calling or emailing us using the contact details below."}]]]}]
d:["$","section","Children’s privacy",{"className":"legal-section","children":[["$","h3",null,{"children":"Children’s privacy"}],[["$","p","This website is intended for business and facility decision-makers. We do not knowingly collect personal information from children.",{"children":"This website is intended for business and facility decision-makers. We do not knowingly collect personal information from children."}]]]}]
e:["$","section","Updates to this policy",{"className":"legal-section","children":[["$","h3",null,{"children":"Updates to this policy"}],[["$","p","We may update this Privacy Policy from time to time. The “Last updated” date at the top of this page will change when revisions are made.",{"children":"We may update this Privacy Policy from time to time. The “Last updated” date at the top of this page will change when revisions are made."}]]]}]
